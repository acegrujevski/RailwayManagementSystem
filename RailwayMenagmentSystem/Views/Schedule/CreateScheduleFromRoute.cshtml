@model RailwayMenagmentSystem.Models.Schedule

@{
    ViewData["Title"] = "Create Schedule";
    var route = ViewData["Route"] as RailwayMenagmentSystem.Models.Route;
}

<h1>Create Schedule</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Route</label>
                <input class="form-control" value="@route?.Name" readonly />
                <input type="hidden" asp-for="RouteId" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainId" class="control-label">Train</label>
                <select asp-for="TrainId"
                        class="form-control"
                        asp-items="ViewBag.TrainId">
                    <option value="">Select Train</option>
                </select>
                <span asp-validation-for="TrainId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DepartureTime" class="control-label">Departure Time</label>
                <input asp-for="DepartureTime" class="form-control" />
                <span asp-validation-for="DepartureTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ArrivalTime" class="control-label">Arrival Time</label>
                <input asp-for="ArrivalTime" class="form-control" />
                <span asp-validation-for="ArrivalTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">Price</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Route" asp-action="Details" asp-route-id="@Model.RouteId">
        Back to Route
    </a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}