@model RailwayMenagmentSystem.Models.Route

@{
    ViewData["Title"] = "Create Route";
    var departureStation = ViewData["DepartureStation"] as RailwayMenagmentSystem.Models.Station;
}

<h1>Create Route</h1>

<h4>Route</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Departure Station</label>
                <input class="form-control" value="@departureStation?.Name" readonly />
                <input type="hidden" asp-for="DepartureStationId" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="ArrivalStationId" class="control-label">Arrival Station</label>
                <select asp-for="ArrivalStationId"
                        class="form-control"
                        asp-items="ViewBag.ArrivalStationId">
                    <option value="">Select Arrival Station</option>
                </select>
                <span asp-validation-for="ArrivalStationId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Station" asp-action="Details" asp-route-id="@Model.DepartureStationId">
        Back to Station
    </a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}