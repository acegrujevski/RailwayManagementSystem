@model RailwayMenagmentSystem.Models.Route

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Route</h4>
    <hr />
    
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            Departure Station
        </dt>

        <dd class="col-sm-10">
            <a asp-controller="Station"
               asp-action="Details"
               asp-route-id="@Model.DepartureStationId">
                @Model.DepartureStation?.Name
            </a>
        </dd>

        <dt class="col-sm-2">
            Arrival Station
        </dt>

        <dd class="col-sm-10">
            <a asp-controller="Station"
               asp-action="Details"
               asp-route-id="@Model.ArrivalStationId">
                @Model.ArrivalStation?.Name
            </a>
        </dd>
    </dl>

</div>

@if (User.IsInRole("Admin"))
{ <div class="mb-3"> <a asp-controller="Schedule"
                        asp-action="CreateScheduleFromRoute"
                        asp-route-routeId="@Model.Id"
                        class="btn btn-primary">
        Create Schedule from this Route </a> </div>
}

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id">
            Edit
        </a>

        
        <span> | </span>
    }

    <a asp-action="Index">
        Back to List
    </a>
    
</div>