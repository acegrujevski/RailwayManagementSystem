<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Railway Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/RailwayMenagmentSystem.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light app-navbar">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Schedule" asp-action="Index">
                Railway Management System
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">

                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Train" asp-action="Index">
                                Trains
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Station" asp-action="Index">
                                Stations
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Route" asp-action="Index">
                                Routes
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Schedule" asp-action="Index">
                            Schedules
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reservation" asp-action="Index">
                            Reservations
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TrainLocation" asp-action="Index">
                                Train Locations
                            </a>
                        </li>
                    }
                </ul>

                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="app-footer">
    <div class="container">
        <span>&copy; 2026 Railway Management System</span>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
