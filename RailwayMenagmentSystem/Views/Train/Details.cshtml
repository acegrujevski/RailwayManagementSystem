@model RailwayMenagmentSystem.Models.Train
@using RailwayMenagmentSystem.Models


@{
    ViewData["Title"] = "Details";
    var schedules = ViewData["Schedules"] as List<RailwayMenagmentSystem.Models.Schedule>;
}

<h1>Details</h1>

<div>
    <h4>Train</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Model)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Capacity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Capacity)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
</div>

@{
    var lastLocation = ViewData["LastLocation"] as TrainLocation;
}

<hr />

<h4>Last Location</h4>

@if (lastLocation != null)
{
    <p>
        <strong>Last seen at:</strong> @lastLocation.Station.Name
    </p>

    <p>
        <strong>Recorded at:</strong> @lastLocation.RecordedAt
    </p>
}
else
{
    <p>No location data available.</p>
}

<hr />

<h4>Schedules</h4>

@if (schedules != null && schedules.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Route</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Price</th>
                <th>Available Seats</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var schedule in schedules)
            {
                <tr>
                    <td>
                        @schedule.Route.DepartureStation.Name -
                        @schedule.Route.ArrivalStation.Name
                    </td>
                    <td>
                        @schedule.DepartureTime
                    </td>
                    <td>
                        @schedule.ArrivalTime
                    </td>
                    <td>
                        @schedule.Price
                    </td>
                    <td>
                        @schedule.AvailableSeats
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No schedules assigned to this train.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>