@model RailwayMenagmentSystem.Models.TrainLocation

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TrainLocation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TrainId" class="control-label"></label>
                <select asp-for="TrainId" class ="form-control" asp-items="ViewBag.TrainId"></select>
            </div>
            <div class="form-group">
                <label asp-for="StationId" class="control-label"></label>
                <select asp-for="StationId" class ="form-control" asp-items="ViewBag.StationId"></select>
            </div>
            <div class="form-group">
                <label asp-for="RecordedAt" class="control-label"></label>
                <input asp-for="RecordedAt" class="form-control" />
                <span asp-validation-for="RecordedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

