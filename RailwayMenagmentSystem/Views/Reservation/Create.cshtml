@model RailwayMenagmentSystem.Models.Reservation

@{
    ViewData["Title"] = "Create Reservation";
    var schedule = ViewData["Schedule"] as RailwayMenagmentSystem.Models.Schedule;
}

<h1>Create Reservation</h1>

@if (schedule != null)
{
    <div class="mb-4">
        <h4>Schedule</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Train</dt>
            <dd class="col-sm-9">@schedule.Train?.Name</dd>

            <dt class="col-sm-3">Route</dt>
            <dd class="col-sm-9">
                @schedule.Route?.DepartureStation?.Name -
                @schedule.Route?.ArrivalStation?.Name
            </dd>

            <dt class="col-sm-3">Departure</dt>
            <dd class="col-sm-9">@schedule.DepartureTime</dd>

            <dt class="col-sm-3">Arrival</dt>
            <dd class="col-sm-9">@schedule.ArrivalTime</dd>

            <dt class="col-sm-3">Price per seat</dt>
            <dd class="col-sm-9">@schedule.Price</dd>

            <dt class="col-sm-3">Available seats</dt>
            <dd class="col-sm-9">@schedule.AvailableSeats</dd>
        </dl>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NumberOfSeats" class="control-label">
                    Number of Seats
                </label>

                <input asp-for="NumberOfSeats"
                       class="form-control"
                       min="1"
                       max="10" />

                <span asp-validation-for="NumberOfSeats"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Confirm Reservation
            </button>

            <a asp-controller="Schedule"
               asp-action="Details"
               asp-route-id="@Model.ScheduleId"
               class="btn btn-secondary">
                Back
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}