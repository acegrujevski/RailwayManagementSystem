@model IEnumerable<RailwayMenagmentSystem.Models.Reservation>
@using RailwayMenagmentSystem.Models.Enums

@{
    ViewData["Title"] = User.IsInRole("Admin") || User.IsInRole("Employee")
        ? "All Reservations"
        : "My Reservations";
}

<h1>@ViewData["Title"]</h1>

@if (User.IsInRole("Admin") || User.IsInRole("User"))
{
    <form asp-action="DeleteAllCancelled"
          method="post"
          class="mb-3"
          onsubmit="return confirm('Are you sure you want to delete all cancelled reservations?');">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Delete All Cancelled
        </button>
    </form>
}

<table class="table">

    <thead>
    <tr>
        <th>Train</th>
        <th>From</th>
        <th>To</th>
        <th>Departure</th>
        <th>Seats</th>
        <th>Reservation Date</th>
        <th>Status</th>

        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
        {
            <th>User</th>
        }

        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @item.Schedule?.Train?.Name
            </td>

            <td>
                @item.Schedule?.Route?.DepartureStation?.Name
            </td>

            <td>
                @item.Schedule?.Route?.ArrivalStation?.Name
            </td>

            <td>
                @item.Schedule?.DepartureTime
            </td>

            <td>
                @item.NumberOfSeats
            </td>

            <td>
                @item.ReservationDate
            </td>

            <td>
                @item.Status
            </td>

            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <td>
                    @item.User?.Email
                </td>
            }

            <td>
                <a asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-secondary">
                    Details
                </a>

                @if (User.IsInRole("User") &&
                     item.Status == ReservationStatus.Active)
                {
                    <form asp-action="Cancel"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to cancel this reservation?');">
                            Cancel
                        </button>
                    </form>
                }

                @if ((User.IsInRole("Admin") || User.IsInRole("User")) &&
                     item.Status == ReservationStatus.Cancelled)
                {
                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this cancelled reservation?');">
                            Delete
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>

</table>