@model RailwayMenagmentSystem.Models.Station
@using RailwayMenagmentSystem.Models

@{
    ViewData["Title"] = "Details";

    var departureSchedules = ViewData["DepartureSchedules"] as List<Schedule>;
    var arrivalSchedules = ViewData["ArrivalSchedules"] as List<Schedule>;
}

<h1>Details</h1>

<div>
    <h4>Station</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
    </dl>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a asp-controller="Route"
           asp-action="CreateRouteFromStation"
           asp-route-departureStationId="@Model.Id"
           class="btn btn-primary">
            Create Route from this Station
        </a>
    </div>
}

<hr />

<h4>Departures</h4>

<table class="table">
    <thead>
        <tr>
            <th>Route</th>
            <th>Train</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var schedule in departureSchedules)
        {
            <tr>
                <td>
                    @schedule.Route?.Name
                </td>
                <td>
                    @schedule.Train?.Name
                </td>
                <td>
                    @schedule.DepartureTime
                </td>
                <td>
                    @schedule.ArrivalTime
                </td>
                <td>
                    @schedule.Price
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h4>Arrivals</h4>

<table class="table">
    <thead>
        <tr>
            <th>Route</th>
            <th>Train</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var schedule in arrivalSchedules)
        {
            <tr>
                <td>
                    @schedule.Route?.Name
                </td>
                <td>
                    @schedule.Train?.Name
                </td>
                <td>
                    @schedule.DepartureTime
                </td>
                <td>
                    @schedule.ArrivalTime
                </td>
                <td>
                    @schedule.Price
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>